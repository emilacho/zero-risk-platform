  {
   "name": "1 · Pedido del reloj",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// 1 · PEDIDO DEL RELOJ · el vigía corre 2 veces al día (esperado medible: 2 ejecuciones/día) · el lunes por la mañana pide además el resumen semanal\nconst ahora = new Date()\nconst lunesTemprano = ahora.getUTCDay() === 1 && ahora.getUTCHours() < 12\nreturn [{ json: { pedido: { accion: 'reloj', resumen: lunesTemprano, workflow_id: String($workflow.id), workflow_execution_id: String($execution.id) } } }]\n"
   },
   "position": [
    280,
    0
   ],
   "id": "e0740bcb-cc1f-32fc-b7ee-f60909f979cd"
  },
  {
   "name": "1 · Reloj",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "parameters": {
    "method": "POST",
    "url": "={{ ($env.ZERO_RISK_API_URL || 'https://zero-risk-platform.vercel.app') + '/api/cadena/esperas' }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "x-api-key",
       "value": "={{ $env.INTERNAL_API_KEY }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.pedido) }}",
    "options": {
     "timeout": 120000,
     "response": {
      "response": {
       "fullResponse": true,
       "neverError": true
      }
     }
    }
   },
   "position": [
    560,
    0
   ],
   "id": "1e74b3b8-4f22-e7b7-1544-2771a1d77cc5"
  },
  {
   "name": "1 · Avisos",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// 1 · AVISOS · UN solo mensaje a #alertas por pasada, agrupado por campaña (nunca uno por fila: el ruido es lo que mata una bandeja) · dice QUÉ HACER, no solo qué pasó\n// En ensayo o en seco el reloj devuelve `enviar_alertas: false`: se REGISTRAN en la ejecución y no se mandan.\nconst r = $input.first().json || {}\nconst status = Number(r.statusCode)\nconst b = r.body && typeof r.body === 'object' ? r.body : {}\nif (status !== 200) throw new Error('VIGIA_RELOJ_' + String(b.code || b.error || status) + ' · ' + String(b.detalle || b.detail || 'sin detalle') + ' · el reloj NO corrió: esto mismo es una alarma')\nif (b.inactivo === true) return [{ json: { enviar: false, hay: false, nota: String(b.motivo || 'cadena apagada') } }]\nconst alertas = Array.isArray(b.alertas) ? b.alertas : []\nconst L = []\nfor (const a of alertas) {\n  L.push('*' + (a.campana_id === 'sistema' ? 'La cadena' : 'Campaña ' + a.campana_id) + '*')\n  for (const l of a.lineas || []) L.push('• ' + l)\n  L.push('')\n}\nif (alertas.length) L.push('*Qué hacer:* revisa la bandeja de aprobaciones; lo que no se apruebe antes de su fecha vence y no se publica solo.')\nconst slack = { channel: 'C0B7XUUEBHA', text: L.join(String.fromCharCode(10)) }\nreturn [{ json: { enviar: b.enviar_alertas === true && alertas.length > 0, hay: alertas.length > 0, slack, registrado: alertas, latido: b.latido || null } }]\n"
   },
   "position": [
    840,
    0
   ],
   "id": "0a52053e-116d-44b0-f0dc-9f39a9d664f3"
  },
  {
   "name": "1 · ¿Hay avisos para mandar?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "combinator": "and",
     "conditions": [
      {
       "leftValue": "={{ $json.enviar === true }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ]
    }
   },
   "position": [
    1120,
    0
   ],
   "id": "904d6810-30c1-85b0-d7a1-f9074dc62c53"
