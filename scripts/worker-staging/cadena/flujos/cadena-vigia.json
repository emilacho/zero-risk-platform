  {
   "name": "2 · Expandir",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "parameters": {
    "jsCode": "// 2 · UNA FILA POR CAMPAÑA ACTIVA · sin campañas, un solo ítem `ninguna` (la corrida termina limpia, no «en error»)\nconst r = $input.first().json || {}\nconst status = Number(r.statusCode)\nconst b = r.body && typeof r.body === 'object' ? r.body : {}\nif (status !== 200) throw new Error('VIGIA_CAMPANAS_' + String(b.code || b.error || status) + ' · ' + String(b.detalle || b.detail || 'sin detalle'))\nconst cs = Array.isArray(b.campanas) ? b.campanas : []\nif (cs.length === 0) return [{ json: { ninguna: true } }]\nreturn cs.map((c) => ({ json: { ninguna: false, campana_id: c.id, client_id: c.client_id, seco: c.seco === true, sala_ref: c.sala_ref || {} } }))\n"
   },
   "position": [
    1960,
    0
   ],
   "id": "f0bee6ae-b176-702a-1c0b-00999ceccc97"
  },
  {
   "name": "2 · ¿Hay campañas?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "parameters": {
