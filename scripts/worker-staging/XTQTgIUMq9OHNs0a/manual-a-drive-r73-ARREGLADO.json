    {
      "id": "d-verificar",
      "name": "Verificar que el PDF esta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2750,
        0
      ],
      "parameters": {
        "jsCode": "// El recibo dice lo que la RESPUESTA de Drive contesto, no lo que se pidio.\nconst patch = $('Nombre y carpeta del PDF').first().json;\nconst r = patch.body || patch;\nconst pdfOk = !!(r && r.id && r.name);\nconst prev = $('Carpeta definitiva').first().json;\n// el documento temporal: Drive contesta 204 (o 200) cuando lo borra · cualquier otra cosa = NO se borro (antes se callaba)\nlet codigo = null, borrado = false;\ntry { const b = $('Borrar el documento intermedio').first().json; codigo = Number(b.statusCode); borrado = codigo === 204 || codigo === 200; } catch (e) { borrado = false; }\nconst ok = pdfOk && borrado;\nconst motivo = !pdfOk ? 'Drive no devolvio el archivo con nombre'\n  : !borrado ? 'el PDF quedo en Drive pero el documento temporal NO se borro (respuesta de Drive: ' + (codigo === null || isNaN(codigo) ? 'sin codigo' : codigo) + ')'\n  : null;\nreturn [{ json: { ok, pdf_ok: pdfOk, intermedio_borrado: borrado, codigo_borrado: (codigo === null || isNaN(codigo)) ? null : codigo,\n  file_id: r && r.id || null, nombre: r && r.name || null,\n  url: r && r.webViewLink || null, folder_id: prev.folder_id,\n  folder_reusada: !!prev.folder_reusada, client_name: prev.client_name,\n  motivo } }];"
      }
    },
    {
      "id": "d-if-ok",
      "name": "Salio bien",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2970,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "d-campana",
      "name": "Campana el manual no llego a Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        3190,
