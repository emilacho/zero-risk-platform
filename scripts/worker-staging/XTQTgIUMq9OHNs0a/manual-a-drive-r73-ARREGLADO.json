      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_EQUIPO }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ($json.pdf_ok ? ':page_facing_up: *El PDF del manual quedo en Drive, pero el cierre no salio limpio* — ' : ':page_facing_up: *El manual no llego a Drive* — ') + ($json.motivo || 'la subida fallo') + '\\n• cliente `' + ($json.client_name || '?') + '`\\n' + ($json.pdf_ok ? '• el PDF *si* esta en la carpeta del cliente · lo que falta es borrar el documento \"(temporal)\" de la raiz de Drive (a la papelera)' : '• el manual *si* quedo guardado en la base · lo que falta es el PDF en Drive\\n• se reintenta disparando este flujo de nuevo con el client_id') }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 15000
        }
      }
    }
