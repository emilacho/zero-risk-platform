    {
      "id": "d-guard",
      "name": "Hay manual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Sin manual no hay nada que subir · se PARA sin ruido (no es un fallo).\nconst b = $json.body || $json;\nif (!b || b.ok !== true || !b.texto) {\n  return [{ json: { _parar: true, motivo: 'la puerta no devolvio manual limpio' } }];\n}\n// Fugas: si algo interno sobrevivio a la limpieza, NO se sube · se avisa.\nif (Array.isArray(b.fugas) && b.fugas.length) {\n  return [{ json: { _parar: true, motivo: 'el manual limpio trae terminos internos: ' + b.fugas.join(' | ') } }];\n}\nreturn [{ json: { client_id: b.client_id, client_name: b.client_name,\n  nombre: b.nombre, texto: b.texto, _parar: false } }];"
      }
    },
    {
      "id": "d-if",
      "name": "Seguir",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json._parar }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ]
        }
      }
    },
    {
      "id": "d-buscar",
      "name": "Buscar carpeta del cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/drive/v3/files?q={{ encodeURIComponent(\"name='\" + $json.client_name.replace(/'/g, \"\\\\'\") + \"' and '1WRmkLvj5CMdbohf4T2INsG0hn5Ebl88d' in parents and mimeType='application/vnd.google-apps.folder' and trashed=false\") }}&fields=files(id,name)&pageSize=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "c3E4Gpy7CArg3SCO",
          "name": "Google account"
        }
      }
    },
    {
      "id": "d-carpeta",
      "name": "Carpeta usar o crear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "jsCode": "// El defecto del modulo de julio era crear SIEMPRE · su propia especificacion pedia\n// \"saltear si ya existe (consultar primero)\" y no se construyo. Aca se consulta.\nconst prev = $('Seguir').first().json;\nconst r = $json.body || $json;\nconst hallada = (r.files && r.files[0]) ? r.files[0].id : null;\nreturn [{ json: Object.assign({}, prev, { folder_id: hallada, folder_reusada: !!hallada }) }];"
      }
    },
    {
      "id": "d-crear-carpeta",
      "name": "Crear carpeta si no existe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "method": "={{ $json.folder_id ? 'GET' : 'POST' }}",
        "url": "=https://www.googleapis.com/drive/v3/files{{ $json.folder_id ? '/' + $json.folder_id : '' }}?fields=id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": "={{ !$json.folder_id }}",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.client_name, mimeType: 'application/vnd.google-apps.folder', parents: ['1WRmkLvj5CMdbohf4T2INsG0hn5Ebl88d'] }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "c3E4Gpy7CArg3SCO",
          "name": "Google account"
        }
      }
    },
    {
      "id": "d-folder-final",
      "name": "Carpeta definitiva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1430,
        0
      ],
      "parameters": {
        "jsCode": "const prev = $('Carpeta usar o crear').first().json;\nconst r = $json.body || $json;\nconst id = prev.folder_id || r.id || null;\nif (!id) { return [{ json: Object.assign({}, prev, { _parar: true, motivo: 'no se pudo obtener la carpeta del cliente' }) }]; }\nreturn [{ json: Object.assign({}, prev, { folder_id: id }) }];"
      }
    },
    {
      "id": "d-subir-doc",
      "name": "Subir texto como documento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1650,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "multipart/related; boundary=zr"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "multipart/related; boundary=zr",
        "body": "={{ '--zr\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n' + JSON.stringify({ name: $json.nombre + ' (temporal)', mimeType: 'application/vnd.google-apps.document' }) + '\\r\\n--zr\\r\\nContent-Type: text/plain; charset=UTF-8\\r\\n\\r\\n' + $json.texto + '\\r\\n--zr--' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
