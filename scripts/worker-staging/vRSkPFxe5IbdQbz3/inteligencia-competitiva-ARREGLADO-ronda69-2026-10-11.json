        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent\": \"competitive-intelligence-agent\",\n  \"model\": \"claude-opus-4-6\",\n  \"task\": \"Synthesize 5-layer CI on {{ $node['Validate'].json.competitor_name }} for client {{ $node['Validate'].json.client_id }}. Layers: (1) Paid Ads — creative themes, hooks, offers, spend estimates. (2) SEO — top organic keywords, content gaps, ranking domains. (3) Social — cadence, formats, top performing posts, employee advocacy. (4) Website — value prop evolution, pricing, funnel design, CRO patterns. (5) PR/News — announcements, funding, leadership, sentiment.\\n\\nDeliver: strategic threat assessment, exploitable weaknesses, counter-moves our client should make this quarter, and a 'steal-this' list of tactical wins. Be specific, quote examples.\",\n  \"client_id\": \"{{ $node['Validate'].json.client_id }}\",\n  \"extra\": {{ JSON.stringify($json) }},\n  \"workflow_id\": \"{{ $workflow.id }}\",\n  \"workflow_execution_id\": \"{{ $execution.id }}\"\n}",
        "options": {
          "timeout": 300000
        }
      }
