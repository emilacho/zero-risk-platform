   },
   {
    "regla": "Entregas el pie de foto y los hashtags en campos aparte.",
    "aplica": "codigo:salida"
   },
   {
    "regla": "Ante correcciones, respondes ítem por ítem: tomada o no tomada, con la razón.",
    "aplica": "codigo:salida"
   }
