# Los constructores de flujos de n8n leen estos archivos con expresiones regulares que esperan fin de línea LF (p. ej. cortar el module.exports del extractor):
# en Windows, con core.autocrlf=true, quedaban en CRLF y las pruebas el-nodo-visual-construccion y los-colores-del-sitio fallaban solo ahí.
scripts/worker-staging/**/*.js text eol=lf
scripts/worker-staging/**/*.mjs text eol=lf
scripts/worker-staging/E39-casilla-negocio/nodos/*.js -text

# Identidades y la migración que las lleva byte a byte a la base (T6b · E4): la guarda md5 y el texto que se aplica dependen de LF;
# en Windows (autocrlf=true) la carpeta de trabajo los volvía CRLF y aplicarlos desde ahí pegaría identidades con CRLF (reserva de CC3).
src/agents/identities/*.md text eol=lf
supabase/migrations/202610312010_*.sql text eol=lf
supabase/reversas/202610312010_*.sql text eol=lf
